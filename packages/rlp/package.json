{
  "name": "@raina-iot/rlp",
  "version": "0.1.0",
  "description": "Raina Link Protocol: compact binary TCP protocol for direct IoT device communication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mengsokool/rlp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "bench": "npm run build && node dist/bench/parser.js",
    "bench:connections": "npm run build && node dist/bench/connections.js",
    "bench:throughput": "npm run build && node dist/bench/throughput.js",
    "bench:fleet": "npm run build && node dist/bench/fleet/index.js"
  }
}
